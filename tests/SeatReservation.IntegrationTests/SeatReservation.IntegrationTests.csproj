<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- xUnit1051 asks every awaited call to take TestContext.Current.CancellationToken.
         These tests drive HTTP against a container and finish in seconds; threading a
         token through every line would add noise without making anything more correct. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit v3 rather than v2: its IAsyncLifetime is ValueTask-based, which lines up
         with WebApplicationFactory's IAsyncDisposable. Under v2 the two DisposeAsync
         signatures collide and the fixture cannot implement both. -->
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.13.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />

    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API only. Referencing the worker as well pulls in a second top-level Program
         class, and WebApplicationFactory<Program> then cannot tell which host to build.
         NotificationHandler lives in Application for the same reason it is testable at
         all: it is a use case, and the worker is only what hosts it. -->
    <ProjectReference Include="..\..\src\SeatReservation.Api\SeatReservation.Api.csproj" />
  </ItemGroup>

</Project>
