# Copy to .env and fill in.  cp .env.example .env
# .env is git-ignored. Never write a real value into this file.

# Database
POSTGRES_DB=seatreservation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key. At least 32 characters; startup validation refuses anything shorter.
# Generate one:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-at-least-32-characters-long-random

# RabbitMQ. The management UI is published on 127.0.0.1:15672; AMQP stays internal.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me-strong-password

# How long seats stay held before the sweeper reclaims them.
HOLD_DURATION=00:10:00

# Host ports. Change these if something else on the machine already uses them.
API_PORT=8080
RABBITMQ_UI_PORT=15672

ASPNETCORE_ENVIRONMENT=Development
