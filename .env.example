# Copy to .env and fill in.  cp .env.example .env
# .env is git-ignored. Never write a real value into this file.

# Database
POSTGRES_DB=seatreservation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key. At least 32 characters; startup validation refuses anything shorter.
# Generate one:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-at-least-32-characters-long-random

# How long seats stay held before the sweeper reclaims them.
HOLD_DURATION=00:10:00

ASPNETCORE_ENVIRONMENT=Development
