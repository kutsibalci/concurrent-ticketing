{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=seatreservation;Username=postgres;Password=",
    "Redis": ""
  },
  "//Jwt": "The worker issues no tokens, but AddInfrastructure validates this section; compose supplies the value through the environment.",
  "Jwt": {
    "SigningKey": ""
  },
  "RabbitMq": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "seatreservation.events",
    "Queue": "seatreservation.notifications"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 8
  }
}
