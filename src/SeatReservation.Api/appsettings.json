{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=seatreservation;Username=postgres;Password=",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "seat-reservation-api",
    "Audience": "seat-reservation-clients",
    "//SigningKey": "Deliberately empty. Supply through user-secrets in development and the environment in production; startup validation refuses to run without it.",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "Reservation": {
    "HoldDuration": "00:10:00",
    "SweepInterval": "00:01:00",
    "SeatMapCacheTtl": "00:00:30"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 8,
    "RetryBaseDelay": "00:00:02",
    "RetryMaxDelay": "00:10:00"
  },
  "//RabbitMq": "Enabled=false keeps the API runnable without a broker. Events still accumulate in the outbox and publish once one is configured.",
  "RabbitMq": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "seatreservation.events",
    "Queue": "seatreservation.notifications"
  }
}
